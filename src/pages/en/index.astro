---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import home from '../../content/pages/home.en.json';
import { highlightHeading } from '../../lib/highlight';
import { getSrcSet } from '../../lib/responsiveImage';
import { withBase } from '../../lib/basePath';
import { getCollection } from 'astro:content';

export const prerender = true;

const BASE = '/en';
const RESPONSIVE_SIZES = '(min-width: 768px) 50vw, 100vw';

// Testimonials (P2C-2a): the collection starts empty — with zero published
// entries this section renders absolutely nothing (no heading, no blank
// space). Once real testimonials exist they'll appear here on their own,
// with no changes to this template.
const testimonials = (await getCollection('testimonialsEn'))
  .filter(t => t.data.published)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

// Portfolio / Selected Work (P2C-2b): the collection starts empty. A
// project only shows once published AND clientConsent are both true —
// never just one of the two. With nothing meeting both, this section
// renders absolutely nothing (no heading, no blank space).
const portfolio = (await getCollection('portfolioEn'))
  .filter(p => p.data.published && p.data.clientConsent)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---
<Layout title={home.title} description={home.metaDescription} image={home.heroImage} base={BASE} locale="en" altHref="/es/" navTheme="light">

  <!-- HERO (VISUAL REDESIGN V2: light) -->
  <section class="on-light mesh-bg-light-hero relative min-h-screen flex items-center pt-24 pb-section-py-sm overflow-hidden">
    <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-accent/10 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 left-1/4 w-80 h-80 rounded-full bg-ink/5 blur-[100px] pointer-events-none"></div>
    <!-- Glow behind the hero image: soft gold instead of the indigo halo
         (tuned for a dark background) — integrates cleanly into the new
         light background instead of reading as a dark smudge. -->
    <div class="absolute top-1/3 right-[6%] w-[30rem] h-[30rem] rounded-full bg-accent/12 blur-[120px] pointer-events-none"></div>

    <div class="max-w-container-max mx-auto px-gutter w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="hero-reveal">
          <span class="tag-cyber mb-6 inline-flex"><Icon name="bolt" class="text-sm" />{home.heroTag}</span>
          <h1 class="font-display text-display-hero-mobile md:text-display-hero-tablet xl:text-display-hero 2xl:text-[92px] mb-6" set:html={highlightHeading(home.heroHeading, home.heroHighlight)}></h1>
          <p class="text-body-lg text-ink-dim mb-8 max-w-xl">
            {home.heroParagraph}
          </p>
          <div class="flex flex-wrap gap-4">
            <!-- PREMIUM EXPERIENCE V1: Cal.com booking CTA. Fallback href
                 unchanged (same Contact page); data-booking-trigger
                 intercepts the click with JS to open the modal instead of
                 navigating. -->
            <a href={withBase(BASE, home.heroCtaPrimary.href)} data-booking-trigger class="btn-cyber-solid magnetic press">
              <span class="icon-wrap">Book a Free Consultation <Icon name="calendar_month" class="text-base" /></span>
            </a>
            <a href={withBase(BASE, home.heroCtaSecondary.href)} class="btn-ghost magnetic press">{home.heroCtaSecondary.label}</a>
          </div>
        </div>
        <div class="hero-reveal reveal-delay">
          <div class="glass card-cyber rounded-2xl overflow-hidden animate-float">
            <img
              src={home.heroImage}
              srcset={getSrcSet(home.heroImage)}
              sizes={RESPONSIVE_SIZES}
              alt={home.heroImageAlt}
              class="w-full aspect-[4/3] object-cover media-bright"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR (light) -->
  <section class="on-light section-surface-alt border-y border-ink/10 py-4 md:py-5">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:gap-x-12 stagger-fade">
        {home.trustBar.map(item => (
          <div class="flex items-center gap-2 text-ink-dim text-sm md:text-base">
            <Icon name={item.icon} class="text-gold-ink text-lg md:text-xl" />
            <span class="font-display font-semibold tracking-wide">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES (light, elevated cards, editorial numbering) -->
  <section id="services" class="on-light section-surface py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-16 reveal">
        <span class="tag-cyber mb-4 inline-flex">{home.servicesTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4" set:html={highlightHeading(home.servicesHeading, home.servicesHighlight)}></h2>
        <p class="text-body-md text-ink-dim max-w-2xl mx-auto">{home.servicesSubtitle}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade">
        {home.services.map((s, i) => (
          <a href={withBase(BASE, s.href)} class="glass card-cyber rounded-2xl p-7 group block relative">
            <span class="editorial-num absolute top-6 right-7" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="w-12 h-12 rounded-xl bg-accent/12 border border-accent/25 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors duration-300">
              <Icon name={s.icon} class="text-gold-ink text-2xl" />
            </div>
            <h3 class="font-display text-headline-md mb-3 group-hover:text-gold-ink transition-colors duration-300">{s.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed mb-5">{s.desc}</p>
            <span class="inline-flex items-center gap-2 text-gold-ink text-sm font-display font-semibold">
              + Learn more <Icon name="arrow_forward" class="text-sm transition-transform duration-200 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ALETHIG MEDIA OS (VISUAL REDESIGN V2: new section, dark on purpose —
       the page's deliberate technology contrast moment). -->
  <section class="bg-bg-void relative py-section-py-sm md:py-section-py-lg overflow-hidden">
    <div class="absolute top-1/4 right-[8%] w-96 h-96 rounded-full bg-accent/8 blur-[130px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-[10%] w-72 h-72 rounded-full bg-grad-indigo/25 blur-[110px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter relative">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <span class="tag-cyber mb-6 inline-flex"><Icon name="bolt" class="text-sm" />{home.osTag}</span>
          <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5" set:html={highlightHeading(home.osHeading, home.osHighlight)}></h2>
          <p class="text-body-md text-text-secondary mb-8 max-w-lg">{home.osBody}</p>
          <a href="https://app.alethigmedia.com" class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap">{home.osCtaLabel} <Icon name="arrow_forward" class="text-base" /></span>
          </a>
        </div>
        <!-- Abstract "dashboard-style" panel: decorative shapes/bars only,
             not a real product screenshot — avoids implying unconfirmed
             features. -->
        <div class="reveal reveal-delay">
          <div class="glass rounded-2xl p-6 md:p-8 border border-accent/15">
            <div class="flex items-center gap-2 mb-6">
              <span class="w-2.5 h-2.5 rounded-full bg-accent/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
            </div>
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <div class="h-2.5 rounded-full bg-accent/60 w-2/3"></div>
                <span class="text-text-dim text-xs font-display">Content</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="h-2.5 rounded-full bg-accent/35 w-1/3"></div>
                <span class="text-text-dim text-xs font-display">Approvals</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="h-2.5 rounded-full bg-accent/50 w-1/2"></div>
                <span class="text-text-dim text-xs font-display">Projects</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="h-2.5 rounded-full bg-accent/25 w-1/4"></div>
                <span class="text-text-dim text-xs font-display">Workflows</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK: renders nothing while the collection is empty. -->
  {portfolio.length > 0 && (
    <section id="work" class="mesh-bg py-section-py-sm md:py-section-py-lg">
      <div class="max-w-container-max mx-auto px-gutter">
        <div class="text-center mb-14 reveal">
          <h2 class="font-display text-headline-lg-mobile md:text-headline-lg">Selected Work</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-fade">
          {portfolio.map(p => (
            <div class={`glass card-cyber rounded-2xl overflow-hidden flex flex-col ${p.data.featured ? 'lumen-border' : ''}`}>
              {p.data.heroImage && (
                <img
                  src={p.data.heroImage}
                  srcset={getSrcSet(p.data.heroImage)}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt={p.data.heroImageAlt ?? p.data.title}
                  class="w-full aspect-video object-cover media-bright"
                  loading="lazy"
                />
              )}
              <div class="p-7 flex flex-col flex-1">
                <span class="tag-cyber mb-4 self-start">{p.data.category}</span>
                <h3 class="font-display text-headline-md mb-2">{p.data.title}</h3>
                <p class="text-text-secondary text-sm leading-relaxed mb-4 flex-1">{p.data.summary}</p>
                {p.data.outcome && <p class="text-accent text-sm font-display font-semibold mb-4">{p.data.outcome}</p>}
                {p.data.clientName && <p class="text-text-dim text-xs mb-4">{p.data.clientName}</p>}
                {p.data.projectUrl && (
                  <a
                    href={p.data.projectUrl}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 text-accent text-sm font-display font-semibold mt-auto"
                    aria-label={`View project: ${p.data.title}`}
                  >
                    View project <Icon name="arrow_forward" class="text-sm" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- WHY CHOOSE US / LOCAL VALUE (light) -->
  <section class="on-light section-surface-alt py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-16 reveal">
        <span class="tag-cyber mb-4 inline-flex">{home.reasonsTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg" set:html={highlightHeading(home.reasonsHeading, home.reasonsHighlight)}></h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-6 stagger-fade">
        {home.reasons.map(r => (
          <div class="glass card-cyber rounded-2xl p-8">
            <Icon name={r.icon} class="text-gold-ink text-3xl mb-4 block" />
            <h3 class="font-display text-headline-md mb-3">{r.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE WORK (VISUAL REDESIGN V2: new section, light, editorial — 4
       steps, large numbering). -->
  <section class="on-light section-surface py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-16 reveal">
        <span class="tag-cyber mb-4 inline-flex">{home.processTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg">{home.processHeading}</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 stagger-fade">
        {home.processSteps.map(step => (
          <div>
            <span class="editorial-num block text-4xl mb-4" style="opacity:0.35">{step.num}</span>
            <h3 class="font-display text-headline-md mb-3">{step.title}</h3>
            <p class="text-ink-dim text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS: renders nothing while the collection is empty. -->
  {testimonials.length > 0 && (
    <section id="testimonials" class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
      <div class="max-w-container-max mx-auto px-gutter">
        <div class="text-center mb-14 reveal">
          <h2 class="font-display text-headline-lg-mobile md:text-headline-lg">What Our Clients Say</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-fade">
          {testimonials.map(t => (
            <div class={`glass card-cyber rounded-2xl p-7 flex flex-col ${t.data.featured ? 'lumen-border' : ''}`}>
              {t.data.rating && (
                <div class="flex gap-1 mb-4" aria-label={`${t.data.rating} out of 5`}>
                  {Array.from({ length: 5 }).map((_, i) => (
                    <Icon name={i < t.data.rating! ? 'star' : 'star_outline'} class="text-accent text-lg" />
                  ))}
                </div>
              )}
              <p class="text-text-secondary text-sm leading-relaxed mb-6 flex-1">"{t.data.quote}"</p>
              <div class="flex items-center gap-3">
                {t.data.photo && (
                  <img
                    src={t.data.photo}
                    srcset={getSrcSet(t.data.photo)}
                    sizes="64px"
                    alt={t.data.clientName}
                    class="w-12 h-12 rounded-full object-cover media-bright flex-shrink-0"
                    loading="lazy"
                  />
                )}
                <div>
                  <p class="font-display font-bold text-text-primary text-sm">{t.data.clientName}</p>
                  {t.data.businessName && <p class="text-text-dim text-xs">{t.data.businessName}</p>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA STRIP -->
  <section class="bg-bg-depth py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass lumen-border rounded-3xl p-12 md:p-16 text-center reveal"
           style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <span class="tag-cyber mb-6 inline-flex">{home.ctaTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5" set:html={highlightHeading(home.ctaHeading, home.ctaHighlight)}></h2>
        <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-8">
          {home.ctaParagraph}
        </p>
        <!-- PREMIUM EXPERIENCE V1: closing CTA converted to Cal.com booking
             (fallback href unchanged). -->
        <a href={withBase(BASE, '/contact')} data-booking-trigger class="btn-cyber-solid magnetic press inline-flex">
          <span class="icon-wrap">Book a Free Consultation <Icon name={home.ctaButtonIcon} class="text-base" /></span>
        </a>
      </div>
    </div>
  </section>

</Layout>
