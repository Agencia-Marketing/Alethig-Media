---
import Layout from '../../../layouts/Layout.astro';
import PlanCard from '../../../components/PlanCard.astro';
import { getCollection } from 'astro:content';
import { highlightHeading } from '../../../lib/highlight';
import { getSrcSet } from '../../../lib/responsiveImage';
import { withBase } from '../../../lib/basePath';

export const prerender = true;

const BASE = '/en';
const RESPONSIVE_SIZES = '(min-width: 768px) 50vw, 100vw';

export async function getStaticPaths() {
  const services = await getCollection('servicesEn');
  return services.map(entry => ({
    // La URL pública en inglés usa urlSlug (distinto del id, que se
    // mantiene igual al español a propósito para emparejar por id).
    params: { slug: entry.data.urlSlug ?? entry.id },
    props: { s: entry.data, id: entry.id },
  }));
}

const { s, id } = Astro.props;
const relatedServices = (await getCollection('servicesEn'))
  .filter(entry => entry.id !== id)
  .sort((a, b) => a.data.order - b.data.order);
// Par en español: mismo id de colección, URL pública en /es/servicios/<id>.
const altHref = `/es/servicios/${id}/`;
---
<Layout title={`${s.title} Long Island NY | Alethig Media`} description={s.metaDescription} image={s.image} base={BASE} locale="en" altHref={altHref}>
  <section class="mesh-bg relative pt-32 pb-section-py-sm overflow-hidden">
    <div class="absolute top-1/3 right-1/4 w-80 h-80 rounded-full bg-accent/5 blur-[120px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <span class="tag-cyber mb-5 inline-flex"><span class="material-symbols-outlined text-sm" aria-hidden="true">{s.icon}</span>{s.title}</span>
          <h1 class="font-display text-display-hero-mobile md:text-5xl font-extrabold mb-5" set:html={highlightHeading(s.heroHeading, s.heroHighlight)}></h1>
          <p class="text-body-lg text-text-secondary mb-8">{s.heroSub}</p>
          <div class="flex gap-4 flex-wrap">
            <a href={withBase(BASE, '/contact')} class="btn-cyber-solid magnetic press">{s.heroCtaLabel}</a>
            <a href="#plans" class="btn-ghost magnetic press">View plans</a>
          </div>
        </div>
        <div class="reveal">
          <div class="glass card-cyber rounded-2xl overflow-hidden animate-float">
            <img
              src={s.image}
              srcset={getSrcSet(s.image)}
              sizes={RESPONSIVE_SIZES}
              alt={s.imageAlt}
              class="w-full aspect-video object-cover media-bright"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="grid md:grid-cols-3 gap-5 stagger-fade">
        {s.features.map(f => (
          <div class="glass card-cyber rounded-2xl p-7">
            <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-accent text-2xl" aria-hidden="true">{f.icon}</span>
            </div>
            <h3 class="font-display font-bold text-lg mb-2">{f.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="plans" class="mesh-bg py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-14 reveal">
        <span class="tag-cyber mb-4 inline-flex">Plans</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg">
          {s.plansHeading ? <>{s.plansHeading}</> : <>Plans and <span class="gradient-text">pricing</span></>}
        </h2>
      </div>
      {s.planGroups && s.planGroups.length ? (
        s.planGroups.map(group => (
          <div class="mb-12 last:mb-0">
            <h3 class="font-display font-bold text-lg md:text-xl mb-6 text-text-primary">{group.label}</h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 stagger-fade">
              {s.plans.filter(p => p.group === group.key).map(p => (
                <PlanCard plan={p} base={BASE} contactHref="/contact" featuredLabel="Most Popular" ctaLabel="Get Started" />
              ))}
            </div>
          </div>
        ))
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 stagger-fade">
          {s.plans.map(p => (
            <PlanCard plan={p} base={BASE} contactHref="/contact" featuredLabel="Most Popular" ctaLabel="Get Started" />
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="mb-8 reveal">
        <span class="tag-cyber mb-4 inline-flex">More Services</span>
        <h2 class="font-display text-headline-md">Explore Our Other Services.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 stagger-fade">
        {relatedServices.map(r => (
          <a href={withBase(BASE, `/services/${r.data.urlSlug ?? r.id}`)} class="glass card-cyber rounded-xl p-5 flex items-center gap-3 group">
            <span class="w-10 h-10 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-accent text-lg" aria-hidden="true">{r.data.icon}</span>
            </span>
            <span class="font-display font-semibold text-sm group-hover:text-accent transition-colors duration-300">{r.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-bg-depth py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass lumen-border rounded-3xl p-12 text-center reveal" style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4">{s.ctaHeading}</h2>
        <p class="text-text-secondary mb-8 max-w-xl mx-auto">{s.ctaText}</p>
        <!-- PREMIUM EXPERIENCE V1: closing CTA converted to Cal.com booking
             (fallback href unchanged). -->
        <a href={withBase(BASE, '/contact')} data-booking-trigger class="btn-cyber-solid magnetic press inline-flex">
          <span class="icon-wrap">Book a Free Consultation <span class="material-symbols-outlined text-base" aria-hidden="true">{s.ctaButtonIcon}</span></span>
        </a>
      </div>
    </div>
  </section>
</Layout>
