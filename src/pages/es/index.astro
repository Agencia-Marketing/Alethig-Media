---
import Layout from '../../layouts/Layout.astro';
import home from '../../content/pages/home.es.json';
import { highlightHeading } from '../../lib/highlight';
import { getSrcSet } from '../../lib/responsiveImage';
import { withBase } from '../../lib/basePath';
import { getCollection } from 'astro:content';

export const prerender = true;

const BASE = '/es';
const RESPONSIVE_SIZES = '(min-width: 768px) 50vw, 100vw';

// Testimonios (P2C-2a): la colección arranca vacía — sin entradas
// publicadas, esta sección no renderiza absolutamente nada (ni título, ni
// espacio en blanco). Cuando existan testimonios reales aparecerán aquí
// solos, sin tocar esta plantilla.
const testimonials = (await getCollection('testimonialsEs'))
  .filter(t => t.data.published)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

// Portfolio / Trabajos (P2C-2b): la colección arranca vacía. Un proyecto
// solo se muestra cuando published Y clientConsent son true — nunca uno
// solo de los dos. Sin entradas que cumplan ambos, esta sección no
// renderiza absolutamente nada (ni título, ni espacio en blanco).
const portfolio = (await getCollection('portfolioEs'))
  .filter(p => p.data.published && p.data.clientConsent)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---
<Layout title={home.title} description={home.metaDescription} image={home.heroImage} base={BASE} locale="es" altHref="/en/">

  <!-- HERO -->
  <section class="mesh-bg-hero relative min-h-screen flex items-center pt-24 pb-section-py-sm overflow-hidden">
    <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full bg-accent/5 blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 left-1/4 w-80 h-80 rounded-full bg-grad-violet/10 blur-[100px] pointer-events-none"></div>
    <!-- Halo detrás de la imagen del hero (Visual P1.5): la integra al fondo
         en vez de que "flote" sobre un campo casi negro. -->
    <div class="absolute top-1/3 right-[6%] w-[30rem] h-[30rem] rounded-full bg-grad-indigo/30 blur-[120px] pointer-events-none"></div>

    <div class="max-w-container-max mx-auto px-gutter w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="hero-reveal">
          <span class="tag-cyber mb-6 inline-flex"><span class="material-symbols-outlined text-sm" aria-hidden="true">bolt</span>{home.heroTag}</span>
          <h1 class="font-display text-display-hero-mobile md:text-display-hero-tablet xl:text-display-hero mb-6" set:html={highlightHeading(home.heroHeading, home.heroHighlight)}></h1>
          <p class="text-body-lg text-text-secondary mb-8 max-w-xl">
            {home.heroParagraph}
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={withBase(BASE, home.heroCtaPrimary.href)} class="btn-cyber-solid magnetic press">
              <span class="icon-wrap">{home.heroCtaPrimary.label} <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_downward</span></span>
            </a>
            <a href={withBase(BASE, home.heroCtaSecondary.href)} class="btn-ghost magnetic press">{home.heroCtaSecondary.label}</a>
          </div>
        </div>
        <div class="hero-reveal reveal-delay">
          <div class="glass card-cyber rounded-2xl overflow-hidden animate-float">
            <img
              src={home.heroImage}
              srcset={getSrcSet(home.heroImage)}
              sizes={RESPONSIVE_SIZES}
              alt={home.heroImageAlt}
              class="w-full aspect-[4/3] object-cover media-bright"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="section-elevated border-y border-white/10 py-4 md:py-5">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:gap-x-12 stagger-fade">
        {home.trustBar.map(item => (
          <div class="flex items-center gap-2 text-text-secondary text-sm md:text-base">
            <span class="material-symbols-outlined text-accent text-lg md:text-xl" aria-hidden="true">{item.icon}</span>
            <span class="font-display font-semibold tracking-wide">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="servicios" class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-16 reveal">
        <span class="tag-cyber mb-4 inline-flex">{home.servicesTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-4" set:html={highlightHeading(home.servicesHeading, home.servicesHighlight)}></h2>
        <p class="text-body-md text-text-secondary max-w-2xl mx-auto">{home.servicesSubtitle}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 stagger-fade">
        {home.services.map(s => (
          <a href={withBase(BASE, s.href)} class="glass card-cyber rounded-2xl p-7 group block">
            <div class="w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center mb-5 group-hover:bg-accent/20 transition-colors duration-300">
              <span class="material-symbols-outlined text-accent text-2xl" aria-hidden="true">{s.icon}</span>
            </div>
            <h3 class="font-display text-headline-md mb-3 group-hover:text-accent transition-colors duration-300">{s.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed mb-5">{s.desc}</p>
            <span class="inline-flex items-center gap-2 text-accent text-sm font-display font-semibold">
              + Más info <span class="material-symbols-outlined text-sm transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">arrow_forward</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TRABAJOS: nada se renderiza mientras la colección esté vacía. -->
  {portfolio.length > 0 && (
    <section id="trabajos" class="mesh-bg py-section-py-sm md:py-section-py-lg">
      <div class="max-w-container-max mx-auto px-gutter">
        <div class="text-center mb-14 reveal">
          <h2 class="font-display text-headline-lg-mobile md:text-headline-lg">Trabajos Seleccionados</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-fade">
          {portfolio.map(p => (
            <div class={`glass card-cyber rounded-2xl overflow-hidden flex flex-col ${p.data.featured ? 'lumen-border' : ''}`}>
              {p.data.heroImage && (
                <img
                  src={p.data.heroImage}
                  srcset={getSrcSet(p.data.heroImage)}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt={p.data.heroImageAlt ?? p.data.title}
                  class="w-full aspect-video object-cover media-bright"
                  loading="lazy"
                />
              )}
              <div class="p-7 flex flex-col flex-1">
                <span class="tag-cyber mb-4 self-start">{p.data.category}</span>
                <h3 class="font-display text-headline-md mb-2">{p.data.title}</h3>
                <p class="text-text-secondary text-sm leading-relaxed mb-4 flex-1">{p.data.summary}</p>
                {p.data.outcome && <p class="text-accent text-sm font-display font-semibold mb-4">{p.data.outcome}</p>}
                {p.data.clientName && <p class="text-text-dim text-xs mb-4">{p.data.clientName}</p>}
                {p.data.projectUrl && (
                  <a
                    href={p.data.projectUrl}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 text-accent text-sm font-display font-semibold mt-auto"
                    aria-label={`Ver proyecto: ${p.data.title}`}
                  >
                    Ver proyecto <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- WHY NEXUS -->
  <section class="section-elevated py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="text-center mb-16 reveal">
        <span class="tag-cyber mb-4 inline-flex">{home.reasonsTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg" set:html={highlightHeading(home.reasonsHeading, home.reasonsHighlight)}></h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-6 stagger-fade">
        {home.reasons.map(r => (
          <div class="glass card-cyber rounded-2xl p-8">
            <span class="material-symbols-outlined text-accent text-3xl mb-4 block" aria-hidden="true">{r.icon}</span>
            <h3 class="font-display text-headline-md mb-3">{r.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS: nada se renderiza mientras la colección esté vacía. -->
  {testimonials.length > 0 && (
    <section id="testimonios" class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
      <div class="max-w-container-max mx-auto px-gutter">
        <div class="text-center mb-14 reveal">
          <h2 class="font-display text-headline-lg-mobile md:text-headline-lg">Lo Que Dicen Nuestros Clientes</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger-fade">
          {testimonials.map(t => (
            <div class={`glass card-cyber rounded-2xl p-7 flex flex-col ${t.data.featured ? 'lumen-border' : ''}`}>
              {t.data.rating && (
                <div class="flex gap-1 mb-4" aria-label={`${t.data.rating} de 5`}>
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class="material-symbols-outlined text-accent text-lg" aria-hidden="true">{i < t.data.rating! ? 'star' : 'star_outline'}</span>
                  ))}
                </div>
              )}
              <p class="text-text-secondary text-sm leading-relaxed mb-6 flex-1">"{t.data.quote}"</p>
              <div class="flex items-center gap-3">
                {t.data.photo && (
                  <img
                    src={t.data.photo}
                    srcset={getSrcSet(t.data.photo)}
                    sizes="64px"
                    alt={t.data.clientName}
                    class="w-12 h-12 rounded-full object-cover media-bright flex-shrink-0"
                    loading="lazy"
                  />
                )}
                <div>
                  <p class="font-display font-bold text-text-primary text-sm">{t.data.clientName}</p>
                  {t.data.businessName && <p class="text-text-dim text-xs">{t.data.businessName}</p>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA STRIP -->
  <section class="bg-bg-depth py-section-py-sm">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="glass lumen-border rounded-3xl p-12 md:p-16 text-center reveal"
           style="background: linear-gradient(135deg, rgba(27,42,107,0.25) 0%, rgba(216,166,42,0.08) 100%);">
        <span class="tag-cyber mb-6 inline-flex">{home.ctaTag}</span>
        <h2 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5" set:html={highlightHeading(home.ctaHeading, home.ctaHighlight)}></h2>
        <p class="text-text-secondary text-body-md max-w-xl mx-auto mb-8">
          {home.ctaParagraph}
        </p>
        <a href={withBase(BASE, '/contacto')} class="btn-cyber-solid magnetic press inline-flex">
          <span class="icon-wrap">{home.ctaButtonLabel} <span class="material-symbols-outlined text-base" aria-hidden="true">{home.ctaButtonIcon}</span></span>
        </a>
      </div>
    </div>
  </section>

</Layout>
