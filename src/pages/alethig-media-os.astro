---
import Layout from '../layouts/Layout.astro';
import os from '../content/pages/alethig-media-os.es.json';
import { highlightHeading } from '../lib/highlight';

export const prerender = true;
---
<Layout title={os.title} description={os.metaDescription}>
  <section class="mesh-bg relative pt-32 pb-section-py-lg overflow-hidden min-h-[70vh] flex items-center">
    <div class="absolute top-1/4 right-1/3 w-72 h-72 rounded-full bg-accent/5 blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 left-1/4 w-64 h-64 rounded-full bg-grad-violet/10 blur-[100px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter w-full">
      <div class="glass lumen-border rounded-2xl p-10 md:p-14 text-center reveal max-w-2xl mx-auto">
        <span class="tag-cyber mb-6 inline-flex">
          <span class="material-symbols-outlined text-sm" aria-hidden="true">construction</span>
          {os.heroTag}
        </span>
        <div class="w-16 h-16 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center mx-auto mb-6">
          <span class="material-symbols-outlined text-accent text-3xl" aria-hidden="true">rocket_launch</span>
        </div>
        <h1 class="font-display text-headline-lg-mobile md:text-headline-lg mb-5" set:html={highlightHeading(os.heading, os.highlight)}></h1>
        <p class="text-body-lg text-text-secondary mb-4 max-w-xl mx-auto">
          {os.paragraph}
        </p>
        <p class="text-text-dim text-sm mb-10">
          {os.note}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/contacto" class="btn-cyber-solid magnetic press inline-flex">
            <span class="icon-wrap">{os.ctaLabel} <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_forward</span></span>
          </a>
          <a href="/" class="btn-ghost magnetic press">{os.ctaSecondaryLabel}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
