---
// "/" es un despachador puro: nunca renderiza contenido propio, siempre
// redirige a la raíz de un idioma (/es/ o /en/). El contenido en español
// vive en /es/ (src/pages/es/index.astro) desde la fase de rutas en
// español; este archivo solo decide A CUÁL de los dos árboles mandar al
// visitante. "/es/" y "/en/" nunca pasan por esta lógica — se sirven
// directo, siempre, sin redirect (crawlers y enlaces directos no rebotan).
//
// prerender:false es necesario: si "/" quedara prerenderizado, Cloudflare
// lo serviría como archivo estático desde el binding de ASSETS y esta
// lógica (que depende de la cookie/cabecera de cada request) nunca se
// ejecutaría — la misma razón por la que los redirects heredados de la
// fase 2 usan la config nativa de Astro en vez de este mismo mecanismo.
export const prerender = false;

type Locale = 'es' | 'en';

// Header Accept-Language: "es-ES,es;q=0.9,en;q=0.8" → probamos cada
// idioma en orden de calidad y nos quedamos con el primero que soportamos
// (es/en); si no hay ninguno reconocible, español por defecto.
function pickLocaleFromAcceptLanguage(header: string | null): Locale {
  if (!header) return 'es';
  const langs = header
    .split(',')
    .map((part) => {
      const [tag, qPart] = part.trim().split(';q=');
      return { tag: tag.trim().toLowerCase(), q: qPart ? parseFloat(qPart) : 1 };
    })
    .sort((a, b) => b.q - a.q);
  for (const { tag } of langs) {
    if (tag.startsWith('en')) return 'en';
    if (tag.startsWith('es')) return 'es';
  }
  return 'es';
}

// Prioridad: 1) cookie pref_lang (elección manual explícita, ya hecha
// antes por el visitante — nunca se pisa) 2) Accept-Language del
// navegador 3) español por defecto.
const cookieLang = Astro.cookies.get('pref_lang')?.value;
const locale: Locale =
  cookieLang === 'en' || cookieLang === 'es'
    ? cookieLang
    : pickLocaleFromAcceptLanguage(Astro.request.headers.get('accept-language'));

// 307 (temporal): el destino depende de cada visitante, no es un
// "movido permanentemente" válido para todos por igual.
return Astro.redirect(`/${locale}/`, 307);
---
