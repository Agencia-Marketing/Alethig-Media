---
// Tarjeta de precio reutilizada por las páginas de servicio en ambos
// idiomas (es/servicios/[slug].astro, en/services/[slug].astro), tanto en
// la grilla plana de siempre como en la variante agrupada (P2C-1). Sin
// <style> propio a propósito: mismas clases Tailwind/globales que ya
// usaba el markup en línea, para que el HTML resultante no cambie donde
// no se pidió agrupar planes.
import { withBase } from '../lib/basePath';

interface Plan {
  name: string;
  sub: string;
  price: string;
  featured: boolean;
  features: string[];
}

interface Props {
  plan: Plan;
  base: string;
  contactHref: string;
  featuredLabel: string;
  ctaLabel: string;
}

const { plan, base, contactHref, featuredLabel, ctaLabel } = Astro.props;
---
<div class={`glass card-cyber rounded-2xl p-7 flex flex-col ${plan.featured ? 'lumen-border scale-105 relative' : ''}`}>
  {plan.featured && <span class="tag-cyber mb-4 self-start">{featuredLabel}</span>}
  <p class="font-display font-bold text-xl mb-1">{plan.name}</p>
  <p class="text-text-secondary text-sm mb-3">{plan.sub}</p>
  <p class="gradient-text font-display font-extrabold text-2xl mb-5">{plan.price}</p>
  <ul class="space-y-2 mb-6 flex-1">
    {plan.features.map(f => (
      <li class="flex items-start gap-2 text-sm text-text-secondary">
        <span class="material-symbols-outlined text-accent text-base mt-0.5 flex-shrink-0" aria-hidden="true">check_circle</span>
        {f}
      </li>
    ))}
  </ul>
  <a href={withBase(base, contactHref)} class={plan.featured ? 'btn-cyber-solid w-full justify-center text-center' : 'btn-ghost w-full justify-center text-center'}>{ctaLabel}</a>
</div>
