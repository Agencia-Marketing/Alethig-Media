---
// Chatbot V1 — widget flotante compacto. Historial de conversación:
// SOLO sessionStorage (nada de servidor/DB), con una clave POR IDIOMA
// (spec aprobada, adjuste 2) para que cambiar de /es/ a /en/ nunca
// reutilice ni mezcle el historial del otro idioma.
interface Props {
  locale: 'es' | 'en';
  // Enlace de Contacto ya resuelto (con base de idioma aplicada) — ya no se
  // usa en el fallback (V2 usa acciones reales de contacto, ver abajo), se
  // conserva por si algún llamador externo aún lo pasa.
  contactHref?: string;
  // WhatsApp (mismo wa.me ya usado por el botón flotante en Layout.astro),
  // teléfono y email — ya resueltos con la base correcta, reutilizados tal
  // cual en las acciones de contacto reales (conversión y fallback), sin
  // inventar rutas ni datos nuevos aquí.
  waHref: string | null;
  phoneHref: string;
  emailHref: string;
  // PREMIUM EXPERIENCE V1 — href de respaldo para el 4to CTA "Reservar
  // llamada" (ya resuelto con la base de idioma correcta, igual que los
  // otros tres). Si Cal.com no carga, el clic navega aquí en vez de abrir
  // el modal — ver src/scripts/cal-booking.ts.
  bookingHref: string;
}
const { locale, waHref, phoneHref, emailHref, bookingHref } = Astro.props;

const STRINGS = {
  es: {
    openLabel: 'Abrir chat de Alethig Media',
    closeLabel: 'Cerrar chat',
    panelLabel: 'Chat de Alethig Media',
    inputLabel: 'Escribe tu mensaje',
    placeholder: 'Escribe tu pregunta…',
    sendLabel: 'Enviar mensaje',
    disclaimer: 'Puede cometer errores. Para cotizaciones exactas, contáctanos.',
    greeting: 'Hola 👋 ¿En qué puedo ayudarte sobre nuestros servicios, precios o la consulta gratuita?',
    fallback: 'No pude responder en este momento, pero podemos ayudarte directamente.',
    rateLimited: 'Estás enviando mensajes muy rápido. Espera un momento y vuelve a intentar.',
    ctaWhatsapp: 'WhatsApp',
    ctaCall: 'Llamar ahora',
    ctaEmail: 'Enviar email',
    ctaBooking: 'Reservar llamada',
  },
  en: {
    openLabel: 'Open Alethig Media chat',
    closeLabel: 'Close chat',
    panelLabel: 'Alethig Media chat',
    inputLabel: 'Type your message',
    placeholder: 'Type your question…',
    sendLabel: 'Send message',
    disclaimer: 'May make mistakes. For exact quotes, contact us.',
    greeting: 'Hi 👋 What would you like to know about our services, pricing, or the free consultation?',
    fallback: "I couldn't respond right now, but you can reach our team directly.",
    rateLimited: "You're sending messages too fast. Please wait a moment and try again.",
    ctaWhatsapp: 'WhatsApp',
    ctaCall: 'Call Now',
    ctaEmail: 'Send Email',
    ctaBooking: 'Schedule a Call',
  },
} as const;
const t = STRINGS[locale] ?? STRINGS.es;
---

<div class="chat-widget" data-chat-root>
  <button
    id="chat-launcher"
    class="chat-launcher"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label={t.openLabel}
  >
    <span class="material-symbols-outlined" aria-hidden="true">chat</span>
  </button>

  <div id="chat-panel" class="chat-panel hidden" role="dialog" aria-modal="false" aria-label={t.panelLabel} aria-hidden="true">
    <div class="chat-header">
      <span class="chat-header-title">Alethig Media</span>
      <button id="chat-close" class="chat-close" type="button" aria-label={t.closeLabel}>
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- data-lenis-prevent: el scroll interno de la lista de mensajes debe
         permanecer 100% nativo — Lenis (motion.ts) nunca debe interceptarlo. -->
    <div id="chat-messages" class="chat-messages" aria-live="polite" data-lenis-prevent></div>

    <div id="chat-typing" class="chat-typing hidden" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <form id="chat-form" class="chat-form" autocomplete="off">
      <label for="chat-input" class="sr-only">{t.inputLabel}</label>
      <input id="chat-input" name="message" type="text" maxlength="500" placeholder={t.placeholder} />
      <button type="submit" class="chat-send" aria-label={t.sendLabel}>
        <span class="material-symbols-outlined" aria-hidden="true">send</span>
      </button>
    </form>
    <p class="chat-disclaimer">{t.disclaimer}</p>
  </div>
</div>

<script define:vars={{ locale, waHref, phoneHref, emailHref, bookingHref, t }}>
  (function () {
    var STORAGE_KEY = 'alethig-chat-' + locale; // historial separado por idioma (alethig-chat-es / alethig-chat-en)
    // V2: si ya se envió un lead en esta conversación, se recuerda por
    // idioma (misma partición que el historial) para no reenviar el mismo
    // correo si el visitante sigue chateando después del momento de
    // conversión — ver el campo leadSent enviado a /api/chat.
    var LEAD_SENT_KEY = 'alethig-chat-leadsent-' + locale;
    var MAX_HISTORY = 16;
    var MAX_MSG_LEN = 500;
    var REQUEST_TIMEOUT_MS = 20000;

    var root = document.querySelector('[data-chat-root]');
    var launcher = document.getElementById('chat-launcher');
    var panel = document.getElementById('chat-panel');
    var closeBtn = document.getElementById('chat-close');
    var messagesEl = document.getElementById('chat-messages');
    var typingEl = document.getElementById('chat-typing');
    var form = document.getElementById('chat-form');
    var input = document.getElementById('chat-input');
    if (!root || !launcher || !panel || !closeBtn || !messagesEl || !typingEl || !form || !input) return;

    function loadHistory() {
      try {
        var raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        var parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return [];
        return parsed
          .filter(function (m) {
            return (
              m &&
              (m.role === 'user' || m.role === 'assistant') &&
              typeof m.content === 'string' &&
              m.content.length > 0 &&
              m.content.length <= MAX_MSG_LEN
            );
          })
          .slice(-MAX_HISTORY);
      } catch (e) {
        return [];
      }
    }
    function saveHistory(history) {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-MAX_HISTORY)));
      } catch (e) {
        /* sessionStorage no disponible (privado/bloqueado) — el chat sigue funcionando, solo sin persistencia */
      }
    }
    function loadLeadSent() {
      try {
        return sessionStorage.getItem(LEAD_SENT_KEY) === '1';
      } catch (e) {
        return false;
      }
    }
    function saveLeadSent() {
      try {
        sessionStorage.setItem(LEAD_SENT_KEY, '1');
      } catch (e) {
        /* igual que el historial: si no hay sessionStorage, el chat sigue funcionando */
      }
    }

    var history = loadHistory();
    var leadSent = loadLeadSent();

    // Nunca innerHTML: ni la entrada del usuario ni la respuesta del modelo
    // se interpretan como marcado — siempre textContent.
    function renderMessage(role, content) {
      var div = document.createElement('div');
      div.className = 'chat-msg chat-msg-' + role;
      div.textContent = content;
      messagesEl.appendChild(div);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    // V2: las tres acciones reales de contacto (WhatsApp / Llamar / Email),
    // como elementos <a> de verdad — nunca texto plano ni URLs crudas. Se
    // usan tanto en el momento de conversión como en el fallback de error,
    // mismo bloque, mismos hrefs ya resueltos (waHref/phoneHref/emailHref).
    // PREMIUM EXPERIENCE V1: se agrega un 4to CTA real "Reservar llamada" —
    // puramente aditivo en la UI, no cambia la lógica de calificación ni de
    // lead-capture (chat.ts / chat-lead.ts / chatbot-context.ts intactos).
    // Es un <a href={bookingHref}> normal (funciona sin JS); con JS, el
    // listener delegado de cal-booking.ts (data-booking-trigger) intercepta
    // el clic y abre el modal de Cal.com en vez de navegar.
    function renderContactActions() {
      var wrap = document.createElement('div');
      wrap.className = 'chat-cta-group';
      var items = [];
      if (waHref) items.push({ href: waHref, label: t.ctaWhatsapp, external: true, booking: false });
      items.push({ href: phoneHref, label: t.ctaCall, external: false, booking: false });
      items.push({ href: emailHref, label: t.ctaEmail, external: false, booking: false });
      items.push({ href: bookingHref, label: t.ctaBooking, external: false, booking: true });
      for (var i = 0; i < items.length; i++) {
        var a = document.createElement('a');
        a.href = items[i].href;
        a.className = 'chat-cta';
        a.textContent = items[i].label;
        if (items[i].external) {
          a.target = '_blank';
          a.rel = 'noopener';
        }
        if (items[i].booking) {
          a.setAttribute('data-booking-trigger', '');
        }
        wrap.appendChild(a);
      }
      messagesEl.appendChild(wrap);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    // V2: chips de respuesta rápida — tocar uno envía ese texto como si el
    // visitante lo hubiera escrito. Se retiran del DOM al usarlos para que
    // no queden chips “viejos” de un paso anterior de la conversación.
    function renderQuickReplies(options) {
      var wrap = document.createElement('div');
      wrap.className = 'chat-quick-replies';
      options.forEach(function (opt) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chat-quick-reply';
        btn.textContent = opt;
        btn.addEventListener('click', function () {
          wrap.remove();
          sendMessage(opt);
        });
        wrap.appendChild(btn);
      });
      messagesEl.appendChild(wrap);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    // V2: un único fallback limpio (sin repetir texto ni acumularse en el
    // historial) + las mismas tres acciones reales de contacto.
    function renderFallback(text) {
      var div = document.createElement('div');
      div.className = 'chat-msg chat-msg-assistant chat-msg-fallback';
      div.textContent = text;
      messagesEl.appendChild(div);
      renderContactActions();
    }

    // El saludo es solo UI (no se guarda en el historial ni se reenvía a
    // la API como si fuera una respuesta real del modelo).
    if (history.length === 0) {
      renderMessage('assistant', t.greeting);
    } else {
      for (var i = 0; i < history.length; i++) renderMessage(history[i].role, history[i].content);
    }

    var lastFocused = null;
    var mqMobile = window.matchMedia('(max-width: 480px)');

    function openPanel() {
      lastFocused = document.activeElement;
      panel.classList.remove('hidden');
      panel.setAttribute('aria-hidden', 'false');
      launcher.setAttribute('aria-expanded', 'true');
      if (mqMobile.matches) document.body.classList.add('chat-open');
      input.focus();
    }
    function closePanel() {
      panel.classList.add('hidden');
      panel.setAttribute('aria-hidden', 'true');
      launcher.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('chat-open');
      (lastFocused || launcher).focus();
    }

    launcher.addEventListener('click', function () {
      if (panel.classList.contains('hidden')) openPanel();
      else closePanel();
    });
    closeBtn.addEventListener('click', closePanel);
    panel.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePanel();
    });

    var sending = false;
    function sendMessage(raw) {
      raw = (raw || '').trim();
      if (sending || !raw || raw.length > MAX_MSG_LEN) return;
      input.value = '';
      sending = true;

      renderMessage('user', raw);
      var historyForRequest = history.slice(-MAX_HISTORY);
      history.push({ role: 'user', content: raw });
      saveHistory(history);
      typingEl.classList.remove('hidden');

      var controller = new AbortController();
      var timeoutId = setTimeout(function () {
        controller.abort();
      }, REQUEST_TIMEOUT_MS);

      fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ locale: locale, message: raw, history: historyForRequest, leadSent: leadSent }),
        signal: controller.signal,
      })
        .then(function (res) {
          clearTimeout(timeoutId);
          typingEl.classList.add('hidden');
          if (res.status === 429) {
            var div = document.createElement('div');
            div.className = 'chat-msg chat-msg-assistant chat-msg-fallback';
            div.textContent = t.rateLimited;
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
            return null;
          }
          if (!res.ok) {
            renderFallback(t.fallback);
            return null;
          }
          return res.json().catch(function () {
            return null;
          });
        })
        .then(function (data) {
          if (data && data.ok && typeof data.reply === 'string') {
            renderMessage('assistant', data.reply);
            history.push({ role: 'assistant', content: data.reply });
            saveHistory(history);
            if (data.leadSent === true) {
              leadSent = true;
              saveLeadSent();
            }
            // Nunca ambos a la vez: el momento de conversión (acciones de
            // contacto) tiene prioridad sobre los quick-replies si el
            // modelo, por error, mandara los dos en el mismo turno.
            if (data.showContactActions === true) {
              renderContactActions();
            } else if (Array.isArray(data.quickReplies) && data.quickReplies.length > 0) {
              renderQuickReplies(data.quickReplies);
            }
          } else if (data === undefined) {
            // ya se manejó arriba (429 / !res.ok)
          } else if (data !== null) {
            renderFallback(t.fallback);
          }
        })
        .catch(function () {
          clearTimeout(timeoutId);
          typingEl.classList.add('hidden');
          renderFallback(t.fallback);
        })
        .finally(function () {
          sending = false;
        });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      sendMessage(input.value);
    });
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Lanzador: circular, dorado, apilado justo encima del botón de WhatsApp
     (que vive en Layout.astro: right/bottom 1.25rem desktop, 1rem en
     ≤480px). Mismo eje horizontal, con espacio suficiente para no tocarlo. */
  .chat-launcher {
    position: fixed;
    right: 1.25rem;
    bottom: 5.5rem;
    z-index: 61;
    width: 52px;
    height: 52px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--bg-void);
    border: none;
    box-shadow: var(--accent-glow);
    cursor: pointer;
    transition: transform 0.25s var(--ease-out-expo), box-shadow 0.25s var(--ease-out-expo);
  }
  .chat-launcher:hover { transform: translateY(-2px); box-shadow: var(--accent-glow-strong); }
  .chat-launcher .material-symbols-outlined { font-size: 26px; }

  @media (max-width: 480px) {
    .chat-launcher { right: 1rem; bottom: 4.75rem; width: 48px; height: 48px; }
  }

  @keyframes chat-launcher-in {
    from { opacity: 0; transform: translateY(12px) scale(0.94); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-launcher { animation: chat-launcher-in 0.5s var(--ease-out-expo) 0.35s both; }
  }

  /* Cuando el panel está abierto en móvil angosto, ocultar el propio
     lanzador (el panel ocupa ese espacio) — el WhatsApp float se oculta
     desde su propia regla en Layout.astro (body.chat-open). */
  @media (max-width: 480px) {
    :global(body.chat-open) .chat-launcher { display: none; }
  }

  .chat-panel {
    position: fixed;
    right: 1.25rem;
    bottom: 9.5rem;
    z-index: 62;
    width: min(360px, calc(100vw - 2.5rem));
    max-height: min(70vh, 560px);
    display: flex;
    flex-direction: column;
    background: var(--bg-depth);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: var(--shadow-glass-lg);
    overflow: hidden;
    transition: opacity 0.3s var(--ease-out-expo), transform 0.3s var(--ease-out-expo);
  }
  .chat-panel.hidden { display: none; }

  @media (max-width: 480px) {
    .chat-panel {
      right: 0.5rem;
      left: 0.5rem;
      bottom: 0.5rem;
      width: auto;
      max-height: min(75vh, 520px);
    }
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--glass-border);
    flex-shrink: 0;
  }
  .chat-header-title {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.95rem;
  }
  .chat-close {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    display: inline-flex;
    padding: 0.25rem;
    border-radius: 8px;
    transition: color 0.2s var(--ease-out-expo);
  }
  .chat-close:hover { color: var(--text-primary); }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 180px;
  }

  .chat-typing {
    display: flex;
    gap: 0.25rem;
    padding: 0 1rem 0.5rem;
    flex-shrink: 0;
  }
  .chat-typing.hidden { display: none; }
  .chat-typing span {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--text-dim);
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-typing span { animation: chat-typing-bounce 1s infinite ease-in-out; }
    .chat-typing span:nth-child(2) { animation-delay: 0.15s; }
    .chat-typing span:nth-child(3) { animation-delay: 0.3s; }
  }
  @keyframes chat-typing-bounce {
    0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }

  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--glass-border);
    flex-shrink: 0;
  }
  .chat-form input {
    flex: 1;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 9999px;
    padding: 0.55rem 0.9rem;
    color: var(--text-primary);
    font-size: 0.85rem;
    font-family: var(--font-body);
  }
  .chat-form input:focus { outline: none; border-color: var(--accent); }
  .chat-send {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--bg-void);
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out-expo);
  }
  .chat-send:hover { transform: translateY(-1px); }
  .chat-send .material-symbols-outlined { font-size: 18px; }

  .chat-disclaimer {
    font-size: 0.65rem;
    color: var(--text-dim);
    text-align: center;
    padding: 0 0.9rem 0.75rem;
    flex-shrink: 0;
  }

  /* Motion reducido: sin transición del panel ni de la entrada del
     lanzador, sin rebote de los puntos de "escribiendo" — mismo patrón
     que .reveal/.hero-reveal en global.css. */
  @media (prefers-reduced-motion: reduce) {
    .chat-launcher { animation: none !important; }
    .chat-panel { transition: none !important; }
    .chat-typing span { animation: none !important; opacity: 0.7; }
  }
</style>

<!-- FIX: estilos de los elementos que el script crea dinámicamente
     (document.createElement) — Astro solo añade su atributo de scope
     (data-astro-cid-*) a los elementos presentes en el markup estático de
     este componente; un elemento creado en runtime nunca lo recibe, así que
     las reglas del <style> de arriba (con scope) nunca los alcanzaban —
     por eso los mensajes, CTAs y quick-replies se veían como texto plano sin
     estilo. Este bloque es is:global A PROPÓSITO y SOLO para esos
     selectores (todos con prefijo "chat-", verificados sin colisión en el
     resto del sitio) — el resto del <style> de arriba (incluyendo .sr-only,
     que sí es un nombre genérico) se deja con scope, sin tocar. No cambia
     comportamiento: mismas reglas, mismos valores, solo sin el atributo de
     scope que nunca podían cumplir. -->
<style is:global>
  .chat-msg {
    max-width: 85%;
    padding: 0.55rem 0.8rem;
    border-radius: 14px;
    font-size: 0.85rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .chat-msg-user {
    align-self: flex-end;
    background: var(--accent-dim);
    border: 1px solid rgba(var(--accent-rgb), 0.25);
    color: var(--text-primary);
  }
  .chat-msg-assistant {
    align-self: flex-start;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
  }
  .chat-msg-fallback { border-style: dashed; }

  /* V2: acciones reales de contacto (WhatsApp / Llamar / Email / Reservar
     llamada) — tarjetas apiladas, no texto ni URLs crudas. Mismo lenguaje
     visual que .btn-cyber-solid (dorado sólido sobre navy) para que se
     sientan como el CTA principal que son, tanto en el momento de
     conversión como en el fallback de error. */
  .chat-cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.1rem;
  }
  .chat-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bg-void);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 9999px;
    padding: 0.55rem 0.9rem;
    text-decoration: none;
    transition: transform 0.2s var(--ease-out-expo), box-shadow 0.2s var(--ease-out-expo);
  }
  .chat-cta:hover { transform: translateY(-1px); box-shadow: var(--accent-glow); }

  /* V2: chips de respuesta rápida — tono más discreto (glass) que las
     acciones de contacto, ya que son un paso intermedio de la
     conversación, no el CTA final. */
  .chat-quick-replies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.1rem;
  }
  .chat-quick-reply {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 9999px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
