---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import { colors, fonts, logo } from '../config/theme.mjs';
// site.json: datos de marca compartidos entre idiomas (hechos, no se traducen).
// site.es.json / site.en.json: textos traducibles (nav, footer, CTA) — uno
// por idioma. contact/whatsapp se reconstruyen abajo con la misma forma que
// tenían en el site.json original, para que el resto de este archivo no
// necesite tocarse.
import site from '../content/settings/site.json';
import siteEs from '../content/settings/site.es.json';
import siteEn from '../content/settings/site.en.json';
import { withBase } from '../lib/basePath';
import ChatbotWidget from '../components/ChatbotWidget.astro';
const { brand, social } = site;
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  // Prefijo de idioma para los links internos del nav/footer (p.ej. "/es").
  // Vacío por defecto: reproduce el comportamiento actual de "/" sin cambios.
  base?: string;
  // Idioma activo. Controla qué copy de site.*.json se usa, el <html lang>,
  // og:locale y las etiquetas de UI (menú, CTA, "Alethig Media OS — pronto").
  locale?: 'es' | 'en';
  // URL de la página equivalente en el otro idioma, para el selector ES/EN.
  // Cada página la calcula (par estático o, en servicios, por urlSlug/id).
  // Si no se pasa, cae al home del otro idioma.
  altHref?: string;
}
const { title, description = 'Alethig Media — Agencia de marketing digital de Long Island. Manejo de redes sociales, producción de video y publicidad pagada en inglés y español.', image = '/uploads/home-hero.webp', noindex = false, base = '', locale = 'es', altHref } = Astro.props;
const siteCopy = locale === 'en' ? siteEn : siteEs;
const { ctaLabel, nav, footerTagline, footerPages, footerLinks, footerBottomLinks, copyright } = siteCopy;
// "phone" = horario de atención (no es un número); "callPhone" es el número
// real, clickeable — se agregan como entradas separadas a propósito (Chatbot
// V2, mejoras mínimas de contacto): horario y teléfono son datos distintos.
const contact = { phone: siteCopy.contactHours, callPhone: site.whatsapp.display, email: site.contact.email, location: site.contact.location };
// Hrefs solo para las entradas que son enlaces reales (email/teléfono); el
// resto del loop del footer no cambia.
const contactHrefs: Record<string, string> = {
  callPhone: `tel:+${site.whatsapp.number}`,
  email: `mailto:${site.contact.email}`,
};
const whatsapp = { ...site.whatsapp, message: siteCopy.whatsappMessage };
const waHref = whatsapp?.number ? `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message ?? '')}` : null;
// Textos de UI (chrome del layout, no contenido de página) por idioma.
const uiCopy = locale === 'en'
  ? { osComingSoon: 'Soon', osComingSoonLong: 'Coming soon', osAriaLabel: 'Alethig Media OS — coming soon', contactPath: '/contact', menuAriaLabel: 'Menu', langSwitchAriaLabel: 'Language' }
  : { osComingSoon: 'Pronto', osComingSoonLong: 'Próximamente', osAriaLabel: 'Alethig Media OS — próximamente', contactPath: '/contacto', menuAriaLabel: 'Menú', langSwitchAriaLabel: 'Idioma' };
// Chatbot V2 — acciones reales de contacto (WhatsApp ya se resuelve más
// abajo como waHref; teléfono y email salen de la misma fuente que ya usa
// el resto del sitio, site.json, sin datos nuevos).
const chatPhoneHref = `tel:+${site.whatsapp.number}`;
const chatEmailHref = `mailto:${site.contact.email}`;
// PREMIUM EXPERIENCE V1 — 4to CTA del chatbot ("Reservar llamada"): mismo
// href de respaldo que ya usa el CTA de "Contacto" del header (uiCopy.contactPath
// con la base de idioma aplicada). Si Cal.com no carga, el clic navega aquí.
const chatBookingHref = withBase(base, uiCopy.contactPath);
// Entrada "Alethig Media OS" (producto en desarrollo, sección separada).
// Un solo lugar para el link: cuando el producto esté listo, cambiar esta
// única línea a la URL real (p.ej. "https://app.alethigmedia.com").
const osHref = withBase(base, '/alethig-media-os');
// Selector ES/EN: el link del idioma activo apunta a la página actual;
// el del otro idioma usa altHref (o el home de ese idioma si no se pasó).
const currentPath = Astro.url.pathname;
const resolvedAltHref = altHref ?? (locale === 'en' ? '/es/' : '/en/');
const esHref = locale === 'es' ? currentPath : resolvedAltHref;
const enHref = locale === 'en' ? currentPath : resolvedAltHref;
const contactIcons: Record<string, string> = { phone: 'schedule', callPhone: 'call', email: 'mail', location: 'location_on' };
const ogImage = new URL(image, Astro.url).href;
const canonical = new URL(Astro.url.pathname, Astro.url).href;

// --- Tema → variables CSS que consume global.css (única fuente: src/config/theme.mjs) ---
const hexToRgb = (hex: string) => {
  const h = hex.replace('#', '');
  const n = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
  return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`;
};
const accentRgb = hexToRgb(colors.accent);
const cssVars: Record<string, string> = {
  '--bg-void': colors['bg-void'],
  '--bg-depth': colors['bg-depth'],
  '--accent': colors.accent,
  '--accent-2': colors['accent-2'],
  '--text-primary': colors['text-primary'],
  '--text-secondary': colors['text-secondary'],
  '--text-dim': colors['text-dim'],
  '--grad-indigo': colors['grad-indigo'],
  '--grad-violet': colors['grad-violet'],
  '--grad-pink': colors['grad-pink'],
  '--accent-rgb': accentRgb,
  '--accent-2-rgb': hexToRgb(colors['accent-2']),
  '--accent-dim': `rgba(${accentRgb}, 0.08)`,
  '--accent-glow': `0 0 40px rgba(${accentRgb}, 0.30)`,
  '--accent-glow-strong': `0 0 80px rgba(${accentRgb}, 0.45)`,
  '--glass-border-accent': `rgba(${accentRgb}, 0.28)`,
  '--font-display': fonts.display,
  '--font-body': fonts.body,
};
const rootStyle = ':root{' + Object.entries(cssVars).map(([k, v]) => `${k}:${v}`).join(';') + '}';

// --- Cloudflare Web Analytics (opcional) ---
// Sin token propio: no se activa nada por defecto. Para habilitarlo, crear el
// sitio en Cloudflare (Analytics & Logs → Web Analytics) y definir
// PUBLIC_CF_BEACON_TOKEN en las variables de entorno del build (no es secreto,
// es público por diseño de Cloudflare, pero no se hardcodea aquí).
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// --- JSON-LD (AdvertisingAgency / LocalBusiness) ---
// Solo se incluyen campos con datos reales presentes en site.json.
// Sin dirección postal completa ni coordenadas: no están en el contenido del sitio.
const siteRoot = new URL('/', Astro.url).href;
const businessSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'AdvertisingAgency',
  name: brand,
  url: siteRoot,
  logo: new URL(logo.image, Astro.url).href,
  image: new URL(logo.image, Astro.url).href,
  description,
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Amityville',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  areaServed: contact.location,
};
if (whatsapp?.number) {
  businessSchema.telephone = `+${whatsapp.number}`;
}
const sameAs = [social?.instagram, social?.facebook, social?.tiktok].filter(Boolean);
if (sameAs.length) businessSchema.sameAs = sameAs;
// Horario tomado tal cual del texto público "Lun a Vie · 9:00 AM – 6:00 PM EST"
businessSchema.openingHoursSpecification = {
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
  opens: '09:00',
  closes: '18:00',
};
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <!-- hreflang: cada página se declara a sí misma + su par en el otro
       idioma (esHref/enHref, mismos valores que usa el selector ES/EN) +
       x-default apuntando a "/" (el despachador de idioma). Recíproco por
       construcción: ambas páginas del par comparten el mismo altHref. -->
  <link rel="alternate" hreflang="es" href={new URL(esHref, Astro.url).href} />
  <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.url).href} />
  <link rel="alternate" hreflang="x-default" href={siteRoot} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={brand} />
  <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_US'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)}></script>

  {cfBeaconToken && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfBeaconToken}"}`}></script>
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fonts.googleHref} rel="stylesheet" />
  <!-- PERFORMANCE OPTIMIZATION V1: el ícono-fuente Material Symbols
       (~3.78MB, variable, todos los ejes) se eliminó por completo — todos
       los íconos ahora son SVG en línea vía <Icon>, ver
       src/components/Icon.astro / src/lib/icons.ts. Sin este <link>, cero
       requests nuevos y cero dependencia de fuente externa para íconos. -->
  <style set:html={rootStyle}></style>
  <style>
    .wa-float {
      position: fixed;
      right: 1.25rem;
      bottom: 1.25rem;
      z-index: 60;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.6rem 0.95rem;
      border-radius: 9999px;
      color: #fff;
      background: #25d366;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.85rem;
      line-height: 1;
      letter-spacing: 0.01em;
      box-shadow: 0 8px 28px rgba(37, 211, 102, 0.45);
      transition: transform 0.25s var(--ease-out-expo), box-shadow 0.25s var(--ease-out-expo);
    }
    .wa-float:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 34px rgba(37, 211, 102, 0.6);
    }
    @media (max-width: 480px) {
      .wa-float { right: 1rem; bottom: 1rem; padding: 0.55rem 0.85rem; }
      /* Chatbot V1: al abrir el panel del chat en móvil angosto, ocultar el
         flotante de WhatsApp para que nunca se solapen (el propio lanzador
         del chat se oculta desde su propio estilo en ChatbotWidget.astro). */
      body.chat-open .wa-float { display: none; }
    }
    /* Entrada única y sutil (Visual P1.6): no es un bounce/pulso continuo,
       corre una sola vez al cargar la página. */
    @keyframes wa-float-in {
      from { opacity: 0; transform: translateY(12px) scale(0.94); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @media (prefers-reduced-motion: no-preference) {
      .wa-float { animation: wa-float-in 0.5s var(--ease-out-expo) 0.3s both; }
    }
  </style>
  <!-- PREMIUM EXPERIENCE V1: si JS está deshabilitado por completo, motion.ts
       nunca se ejecuta — esta es la única red de seguridad que aplica en ese
       caso, forzando visibilidad total en el contenido que .reveal /
       .stagger-fade / .hero-reveal dejan oculto por defecto (global.css). -->
  <noscript>
    <style>
      .reveal, .stagger-fade > *, .hero-reveal { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>
</head>
<body class="noise-overlay">

  <!-- NAV -->
  <header id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex items-center justify-between h-20 transition-all duration-300" id="nav-inner">
        <!-- Logo -->
        <a href={withBase(base, '/')} class="flex items-center group" aria-label={brand}>
          {logo.image
            ? <img src={logo.image} alt={logo.alt} class="h-12 w-auto md:h-16" />
            : <span class="font-display font-bold text-lg tracking-tight text-text-primary group-hover:text-accent transition-colors duration-300">{brand}</span>
          }
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-8">
          {nav.map(item => (
            <a href={withBase(base, item.href)} class="text-label-sm text-text-secondary hover:text-text-primary transition-colors duration-200 uppercase tracking-widest">{item.label}</a>
          ))}
        </nav>

        <!-- CTA + Mobile toggle -->
        <div class="flex items-center gap-4">
          <!-- Selector ES/EN -->
          <div class="hidden md:flex items-center gap-0.5 text-xs border border-white/10 rounded-full p-0.5" role="group" aria-label={uiCopy.langSwitchAriaLabel}>
            <a href={esHref} data-set-lang="es" aria-current={locale === 'es' ? 'page' : undefined} class={`px-2.5 py-1 rounded-full font-display font-semibold uppercase tracking-wider transition-colors duration-200 ${locale === 'es' ? 'bg-accent/15 text-accent' : 'text-text-dim hover:text-text-secondary'}`}>ES</a>
            <a href={enHref} data-set-lang="en" aria-current={locale === 'en' ? 'page' : undefined} class={`px-2.5 py-1 rounded-full font-display font-semibold uppercase tracking-wider transition-colors duration-200 ${locale === 'en' ? 'bg-accent/15 text-accent' : 'text-text-dim hover:text-text-secondary'}`}>EN</a>
          </div>
          <a
            href={osHref}
            class="hidden lg:inline-flex items-center gap-1.5 text-[11px] text-text-dim hover:text-accent border border-white/10 hover:border-accent/30 rounded-full px-3 py-1.5 transition-colors duration-200"
            aria-label={uiCopy.osAriaLabel}
          >
            <Icon name="bolt" class="text-sm" />
            Alethig Media OS
            <span class="uppercase tracking-wider opacity-70">· {uiCopy.osComingSoon}</span>
          </a>
          <div class="hidden md:block">
            <a href={withBase(base, uiCopy.contactPath)} class="btn-cyber press">
              <span class="icon-wrap">{ctaLabel} <Icon name="arrow_forward" class="text-base" /></span>
            </a>
          </div>
          <button id="menu-btn" class="md:hidden glass p-2 rounded-lg" aria-label={uiCopy.menuAriaLabel} aria-expanded="false" aria-controls="mobile-menu">
            <Icon name="menu" class="text-text-primary" />
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden glass mx-4 mb-4 rounded-2xl overflow-hidden">
      <nav class="flex flex-col p-4 gap-1">
        {nav.map(item => (
          <a href={withBase(base, item.href)} class="px-4 py-3 text-text-secondary hover:text-accent rounded-lg transition-all text-sm font-display font-semibold uppercase tracking-widest">{item.label}</a>
        ))}
        <div class="flex items-center gap-2 px-4 py-2" role="group" aria-label={uiCopy.langSwitchAriaLabel}>
          <a href={esHref} data-set-lang="es" aria-current={locale === 'es' ? 'page' : undefined} class={`flex-1 text-center py-2 rounded-lg text-xs font-display font-semibold uppercase tracking-widest transition-colors ${locale === 'es' ? 'bg-accent/15 text-accent' : 'text-text-dim hover:text-text-secondary border border-white/10'}`}>Español</a>
          <a href={enHref} data-set-lang="en" aria-current={locale === 'en' ? 'page' : undefined} class={`flex-1 text-center py-2 rounded-lg text-xs font-display font-semibold uppercase tracking-widest transition-colors ${locale === 'en' ? 'bg-accent/15 text-accent' : 'text-text-dim hover:text-text-secondary border border-white/10'}`}>English</a>
        </div>
        <a href={osHref} class="px-4 py-3 text-text-dim hover:text-accent rounded-lg transition-all flex items-center gap-3">
          <Icon name="bolt" class="text-sm flex-shrink-0" />
          <span class="flex flex-col leading-tight">
            <span class="text-xs font-display font-semibold uppercase tracking-widest">Alethig Media OS</span>
            <span class="text-[10px] opacity-70">{uiCopy.osComingSoonLong}</span>
          </span>
        </a>
        <div class="pt-2 mt-1 border-t border-[rgba(255,255,255,0.07)]">
          <a href={withBase(base, uiCopy.contactPath)} class="btn-cyber-solid w-full justify-center text-center block">{ctaLabel}</a>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="mesh-bg-alt lumen-border mt-0">
    <div class="max-w-container-max mx-auto px-gutter py-section-py-sm">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-16">
        <!-- Brand -->
        <div>
          <a href={withBase(base, '/')} class="inline-flex mb-4" aria-label={brand}>
            {logo.image
              ? <img src={logo.image} alt={logo.alt} class="h-10 w-auto" />
              : <span class="font-display font-bold text-lg text-text-primary">{brand}</span>
            }
          </a>
          <p class="text-text-secondary text-sm leading-relaxed mb-5">{footerTagline}</p>
          <div class="flex gap-3">
            {social?.instagram && (
              <a href={social.instagram} target="_blank" rel="noopener" class="glass p-2 rounded-lg hover:border-accent/40 transition-all" aria-label="Instagram">
                <svg class="w-5 h-5 fill-current text-text-secondary" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.6.22 1 .48 1.4.9.42.4.68.8.9 1.4.17.4.36 1 .42 2.2.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.25 1.8-.42 2.2-.22.6-.48 1-.9 1.4-.4.42-.8.68-1.4.9-.4.17-1 .36-2.2.42-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.25-2.2-.42-.6-.22-1-.48-1.4-.9-.42-.4-.68-.8-.9-1.4-.17-.4-.36-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-1.8.42-2.2.22-.6.48-1 .9-1.4.4-.42.8-.68 1.4-.9.4-.17 1-.36 2.2-.42C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.07-.9.04-1.4.2-1.7.32-.43.17-.74.37-1.06.7-.32.32-.52.63-.7 1.06-.12.3-.28.8-.32 1.7C3.45 8.5 3.45 8.9 3.45 12s0 3.5.07 4.7c.04.9.2 1.4.32 1.7.17.43.37.74.7 1.06.32.32.63.52 1.06.7.3.12.8.28 1.7.32 1.2.06 1.6.07 4.7.07s3.5 0 4.7-.07c.9-.04 1.4-.2 1.7-.32.43-.17.74-.37 1.06-.7.32-.32.52-.63.7-1.06.12-.3.28-.8.32-1.7.06-1.2.07-1.6.07-4.7s0-3.5-.07-4.7c-.04-.9-.2-1.4-.32-1.7-.17-.43-.37-.74-.7-1.06-.32-.32-.63-.52-1.06-.7-.3-.12-.8-.28-1.7-.32-1.2-.06-1.6-.07-4.7-.07zm0 3.06A4.94 4.94 0 1 1 12 17a4.94 4.94 0 0 1 0-9.88zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28zm5.15-3.2a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3z"/></svg>
              </a>
            )}
            {social?.facebook && (
              <a href={social.facebook} target="_blank" rel="noopener" class="glass p-2 rounded-lg hover:border-accent/40 transition-all" aria-label="Facebook">
                <svg class="w-5 h-5 fill-current text-text-secondary" viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
              </a>
            )}
            {social?.tiktok && (
              <a href={social.tiktok} target="_blank" rel="noopener" class="glass p-2 rounded-lg hover:border-accent/40 transition-all" aria-label="TikTok">
                <svg class="w-5 h-5 fill-current text-text-secondary" viewBox="0 0 24 24"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.2v12.9a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.77.12v-3.3a5.9 5.9 0 0 0-.77-.05A5.9 5.9 0 1 0 15.65 16V9.6a7.43 7.43 0 0 0 4.35 1.4V7.7a4.28 4.28 0 0 1-3.4-1.88z"/></svg>
              </a>
            )}
          </div>
        </div>

        <!-- Contact -->
        <div>
          <p class="tag-cyber mb-5">Contacto</p>
          <ul class="space-y-3">
            {Object.entries(contact).map(([key, value]) => (
              <li class="flex items-center gap-3 text-text-secondary text-sm">
                <Icon name={contactIcons[key] ?? 'circle'} class="text-accent text-base" />
                {contactHrefs[key]
                  ? <a href={contactHrefs[key]} class="hover:text-accent transition-colors duration-200">{value}</a>
                  : value}
              </li>
            ))}
          </ul>
        </div>

        <!-- Pages -->
        <div>
          <p class="tag-cyber mb-5">Páginas</p>
          <ul class="space-y-2">
            {footerPages.map(item => (
              <li><a href={withBase(base, item.href)} class="text-text-secondary text-sm hover:text-accent transition-colors duration-200">{item.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Quick links -->
        <div>
          <p class="tag-cyber mb-5">Enlaces</p>
          <ul class="space-y-2">
            {footerLinks.map(item => (
              <li><a href={withBase(base, item.href)} class="text-text-secondary text-sm hover:text-accent transition-colors duration-200">{item.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <div class="cyber-divider mb-8"></div>
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
