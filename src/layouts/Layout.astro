  <!-- CHATBOT V1 -->
  <ChatbotWidget locale={locale} waHref={waHref} phoneHref={chatPhoneHref} emailHref={chatEmailHref} bookingHref={chatBookingHref} />

</body>
</html>

<script>
  // PREMIUM EXPERIENCE V1: GSAP/ScrollTrigger + Lenis + Cal.com. Reemplaza
  // atómicamente el antiguo IntersectionObserver de reveal (ver git
  // history) — ver src/scripts/motion.ts para el detalle completo,
  // incluyendo las redes de seguridad de visibilidad.
  import { initMotion } from '../scripts/motion';
  import { initBookingTriggers } from '../scripts/cal-booking';

  // ---- Scroll: sticky nav glassify ----
  const nav = document.getElementById('site-nav');
  const navInner = document.getElementById('nav-inner');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      nav!.style.cssText = 'background:rgba(0,3,38,0.82);backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);border-bottom:1px solid rgba(255,255,255,0.07);';
      navInner!.style.height = '64px';
    } else {
      nav!.style.cssText = '';
      navInner!.style.height = '80px';
    }
  }, { passive: true });

  // ---- Mobile menu ----
  const menuBtn = document.getElementById('menu-btn');
  menuBtn?.addEventListener('click', () => {
    const m = document.getElementById('mobile-menu');
    const isHidden = m?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
  });

  // ---- Selector ES/EN: recuerda la elección manual 1 año, nunca la pisa ----
  document.querySelectorAll('[data-set-lang]').forEach((el) => {
    el.addEventListener('click', () => {
      const lang = el.getAttribute('data-set-lang');
      if (lang) document.cookie = `pref_lang=${lang}; max-age=31536000; path=/; samesite=lax`;
    });
  });

  // ---- Reveal (GSAP) + smooth scroll (Lenis) + triggers de reserva ----
  initMotion();
  initBookingTriggers();

  // ---- Magnetic buttons ----
  document.querySelectorAll('.magnetic').forEach(el => {
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const r = (el as HTMLElement).getBoundingClientRect();
      const x = (e.clientX - r.left - r.width / 2) * 0.35;
      const y = (e.clientY - r.top - r.height / 2) * 0.35;
      (el as HTMLElement).style.transform = `translate(${x}px,${y}px)`;
    });
    el.addEventListener('mouseleave', () => { (el as HTMLElement).style.transform = ''; });
  });
</script>
