{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alethig-media",
  "account_id": "b4de9830e2439fbae8c22197183b60c3",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  // Sirve el sitio (HTML/CSS/JS/imágenes) desde dist; el Worker maneja /api/*.
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  // KV: almacena cada envío del formulario de contacto (Fase A, funciona sin dominio).
  // Namespace creado en Cloudflare: alethig-media-SUBMISSIONS
  "kv_namespaces": [
    { "binding": "SUBMISSIONS", "id": "e5e3e7ef5f334a3e97a766cf0f6b7529" }
  ]
  // Fase B (cuando el dominio esté en TU cuenta Cloudflare): descomentar para activar email.
  // ,"send_email": [{ "name": "EMAIL" }]
}
