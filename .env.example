# Variables de entorno de build (Astro/Vite). Copiar a ".env" en local — no se commitea.
#
# Nota: TURNSTILE_SECRET_KEY y RESEND_API_KEY NO van aquí — son secrets del
# runtime de Cloudflare (usados en src/pages/api/contact.ts vía locals.runtime.env)
# y se configuran en ".dev.vars" para local, ver ".dev.vars.example".

# Cloudflare Web Analytics (opcional). Token público del beacon — se obtiene
# en el dashboard de Cloudflare: Analytics & Logs → Web Analytics → Add site.
# Sin esta variable, el sitio funciona igual: simplemente no se carga el beacon.
PUBLIC_CF_BEACON_TOKEN=
